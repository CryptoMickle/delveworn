# Active deployment for delveworn.app (the legacy RISE site is separate).
NEXT_PUBLIC_DEPLOYMENT=somniaShannon

# Keep the upgraded site canonical on delveworn.app when switching networks.
# The separate Somnia site keeps its own project configuration.
NEXT_PUBLIC_SITE_URL=https://delveworn.app

# RISE Testnet deployment-specific configuration
# Public Delveworn beta contract, documented in the repository README.
NEXT_PUBLIC_RISE_TESTNET_DUNGEON_ADDRESS=0xf5d7Da409545E74bD9d4fEaD8365AF0158c43DbA
NEXT_PUBLIC_RISE_TESTNET_RPC_URL=https://testnet.riselabs.xyz
NEXT_PUBLIC_RISE_TESTNET_WS_URL=wss://testnet.riselabs.xyz/ws
NEXT_PUBLIC_RISE_TESTNET_EXPLORER_URL=https://explorer.testnet.riselabs.xyz

# Somnia Shannon testnet used by delveworn.app.
NEXT_PUBLIC_SOMNIA_SHANNON_DUNGEON_ADDRESS=0x07c5D071132ae95C3708031790b3feC740F4c292
NEXT_PUBLIC_SOMNIA_SHANNON_RPC_URL=https://api.infra.testnet.somnia.network/
NEXT_PUBLIC_SOMNIA_SHANNON_WS_URL=wss://api.infra.testnet.somnia.network/ws
NEXT_PUBLIC_SOMNIA_SHANNON_EXPLORER_URL=https://shannon-explorer.somnia.network/

# Somnia Popup-free Play is enabled in the delveworn.app Vercel project.
# For local development, enable only with a public Thirdweb client that allows
# your development domain and sponsors Shannon testnet transactions.
NEXT_PUBLIC_SOMNIA_SESSION_KEYS_ENABLED=false
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=

# Optional informal Weekly Challenge leaderboard. Production stays disabled
# until a durable Upstash-compatible Redis store and a private signing secret
# are configured. The cookie secret should be at least 32 random characters.
# Set this explicit kill switch to false to disable reads and submissions even
# when every other leaderboard setting is present.
# DELVEWORN_LEADERBOARD_ENABLED=false
KV_REST_API_URL=
KV_REST_API_TOKEN=
DELVEWORN_LEADERBOARD_COOKIE_SECRET=

# Optional Redis-only isolation when Preview and Production share one database.
# Set production in the Production environment; leave Preview unset to preserve
# its existing standings. Use 1–32 letters, numbers, hyphens or underscores.
# DELVEWORN_LEADERBOARD_NAMESPACE=production

# These Upstash names can be used instead of the KV_REST_API_* pair.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional nonproduction override. Local development otherwise uses a file in
# the operating system temporary directory. This setting is ignored as a
# production fallback.
# DELVEWORN_LEADERBOARD_LOCAL_FILE=

# Legacy fallbacks retained for backwards compatibility.
# Prefer the deployment-specific variables above for new setups.
# NEXT_PUBLIC_DUNGEON_ADDRESS=0x0000000000000000000000000000000000000000
# NEXT_PUBLIC_RPC_URL=https://testnet.riselabs.xyz
# NEXT_PUBLIC_WS_URL=wss://testnet.riselabs.xyz/ws
# NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.riselabs.xyz
